<Page x:Class="MusicAppFront.Views.Pages.EmailConfirmationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicAppFront.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="400"
      Title="EmailConfirmationPage"
      Background="Transparent">

    <Grid VerticalAlignment="Center" Margin="40,0">
        <StackPanel>
            <TextBlock Text="Подтверждение" 
                       Foreground="{StaticResource PrimaryText}" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Margin="0,0,0,12"/>

            <TextBlock Text="Мы отправили код на ваш Email. Пожалуйста, введите его ниже." 
                       Foreground="{StaticResource SecondaryText}" 
                       TextWrapping="Wrap" 
                       FontSize="14" 
                       LineHeight="20"
                       Margin="0,0,0,40"/>

            <TextBlock Text="Код из письма" 
                       Foreground="{StaticResource SecondaryText}" 
                       FontSize="12" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,10"/>

            <TextBox Style="{StaticResource ModernTextBox}" 
                     x:Name="CodeInput"
                     MaxLength="6"
                     FontSize="28"
                     Height="60"
                     FontWeight="Bold"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     Background="#18181B"/>

            <Button Content="ПОДТВЕРДИТЬ" 
                    Style="{StaticResource ModernButton}" 
                    Margin="0,35,0,0" 
                    Height="50"
                    Click="ConfirmCode_Click"/>

            <StackPanel Margin="0,30,0,0">
                <Button x:Name="ResendButton" 
                        Content="Отправить код еще раз" 
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="ResendButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" 
                                    Value="Transparent"/>
                            <Setter Property="Foreground" 
                                    Value="{StaticResource SecondaryText}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" 
                                         Value="True">
                                    <Setter Property="Foreground" 
                                            Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" 
                                         Value="False">
                                    <Setter Property="Opacity" 
                                            Value="0.4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock x:Name="TimerText" 
                           Text="Повторная отправка через 00:59" 
                           Foreground="{StaticResource SecondaryText}" 
                           HorizontalAlignment="Center" 
                           FontSize="12"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
