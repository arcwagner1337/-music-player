<Page x:Class="MusicAppFront.Views.Pages.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicAppFront.Views.Pages"
      mc:Ignorable="d" 
      Title="SearchPage">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <StackPanel Margin="30,20">
        <TextBlock Text="Результаты поиска:" 
                   Foreground="{StaticResource PrimaryText}"  
                   FontSize="38" FontWeight="Black" Margin="10,0,0,25"/>

        <TextBlock Text="Артисты" Foreground="White" FontSize="22" 
                   FontWeight="Bold" Margin="10,0,0,15"/>
        
        <ItemsControl x:Name="ArtistsList" Margin="0,0,0,30">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel /> </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ArtistCardStyle}" 
                            Content="{Binding Name}" 
                            Tag="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Треки" Foreground="White" FontSize="22" 
                   FontWeight="Bold" Margin="10,0,0,15"/>
        
        <ContentControl Style="{StaticResource TrackListContainer}" Margin="0,0,0,40">
            <ItemsControl x:Name="TracksList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TrackRowStyle}" 
                                Click="TrackRow_Click"
                                Tag="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>

        <TextBlock Text="Альбомы и плейлисты" Foreground="White" FontSize="22" 
                   FontWeight="Bold" Margin="10,0,0,15"/>
        
        <ItemsControl x:Name="AlbumsList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource PlaylistCardStyle}" 
                            Content="{Binding Name}"
                            Tag="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Height="80"/>
    </StackPanel>
</ScrollViewer>
</Page>
