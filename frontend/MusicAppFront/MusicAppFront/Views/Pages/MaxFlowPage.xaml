<Page x:Class="MusicAppFront.Views.Pages.MaxFlowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicAppFront.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MaxFlowPage">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="30">
            <Grid Margin="10,0,0,30">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Max" 
                                   Foreground="{StaticResource PrimaryText}"
                                   FontSize="36" 
                                   FontWeight="Black"/>
                        <TextBlock Text="Flow" 
                                   FontSize="36" 
                                   FontWeight="Bold">
                            <TextBlock.Foreground>
                                <StaticResource ResourceKey="AccentGradient"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Персональный поток музыки. Слушай то, что любишь" 
                               Foreground="{StaticResource SecondaryText}" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Margin="3,0,0,0" 
                               Opacity="0.8"/>
                </StackPanel>
            </Grid>
            <ContentControl Style="{StaticResource TrackListContainer}">
                <StackPanel>
                    <Button Style="{StaticResource TrackRowStyle}"/>
                    <Button Style="{StaticResource TrackRowStyle}"/>
                    <Button Style="{StaticResource TrackRowStyle}"/>
                    <Button Style="{StaticResource TrackRowStyle}"/>
                    <Button Style="{StaticResource TrackRowStyle}"/>
                    <Button Style="{StaticResource TrackRowStyle}"/>
                    <Button Style="{StaticResource TrackRowStyle}"/>
                    <Button Style="{StaticResource TrackRowStyle}"/>
                </StackPanel>
            </ContentControl>
            <Border Height="50"/>
        </StackPanel>
    </ScrollViewer>
</Page>
