<Page x:Class="MusicAppFront.Views.Pages.CreatePlaylist"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicAppFront.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="CreatePlaylistPage">

    <Grid Margin="40,40">
        <StackPanel>
            <TextBlock Text="Новый плейлист" 
                       Foreground="White" 
                       FontSize="56" 
                       FontWeight="Black" 
                       Margin="10,0,0,60"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="550"/>
                </Grid.ColumnDefinitions>

                <Border Width="220" 
                        Height="220" 
                        CornerRadius="25">
                    <Border.Background>
                        <ImageBrush ImageSource="/Resources/logo.png" 
                                    Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="45" 
                                          Opacity="0.5" 
                                          ShadowDepth="0" 
                                          Color="Black"/>
                    </Border.Effect>
                </Border>

                <StackPanel Grid.Column="1" 
                            VerticalAlignment="Center" 
                            Margin="60,0,0,0">
                    <TextBlock Text="НАЗВАНИЕ" 
                               Foreground="{StaticResource SecondaryText}" 
                               FontSize="25" FontWeight="Bold" 
                               Margin="5,0,0,10" 
                               Opacity="0.7"/>

                    <TextBox x:Name="PlaylistNameTextBox" Style="{StaticResource ModernTextBox}" 
                             FontSize="18"
                             Height="55" 
                             HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" 
                        Margin="10,60,0,0">
                <Button Content="Создать плейлист" 
                        Style="{StaticResource AccentActionBtn}" 
                        Click="CreatePlaylist_Click"
                        Width="240" 
                        Height="50" 
                        FontSize="16"/>
                <Button Content="Отмена" 
                        Style="{StaticResource DangerActionBtn}" 
                        Width="180" Height="50" 
                        Margin="25,0,0,0"
                        Click="Cancel_Click" FontSize="16"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
