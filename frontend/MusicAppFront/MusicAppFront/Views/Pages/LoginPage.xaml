<Page x:Class="MusicAppFront.Views.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicAppFront.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="400"
      Title="LoginPage"
      Background="Transparent">

    <Page.Resources>
        <Storyboard x:Key="RotateAnimation">
            <DoubleAnimation Storyboard.TargetName="LoadingIcon"
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                         From="0" To="360" Duration="0:0:1" 
                         RepeatBehavior="Forever"/>
        </Storyboard>
    </Page.Resources>

    <StackPanel VerticalAlignment="Center" Margin="40,0">
        <StackPanel Orientation="Horizontal" 
            HorizontalAlignment="Center" 
            Margin="0,0,0,30">
            <Border Width="40" 
                Height="50" 
                CornerRadius="12" 
                ClipToBounds="True">
                    <Image Source="/Resources/logo.png"
                           Stretch="UniformToFill"/>
            </Border>
            <StackPanel VerticalAlignment="Center"
                        Margin="7,0,0,0">
                <TextBlock Text="MAX"
                           Foreground="White" 
                           FontSize="20"
                           FontWeight="Black"/>
                <TextBlock Text="MUSIC"
                           Foreground="{StaticResource AccentGradient}" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Margin="0,-4,0,0"/>
                </StackPanel>
        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock" 
           Foreground="#FF5555" 
           FontSize="12" 
           HorizontalAlignment="Center" 
           Margin="0,10,0,0" 
           TextWrapping="Wrap"
           Visibility="Collapsed" 
           Text="Ошибка входа"/>



        <TextBlock Text="Войти" 
                   Foreground="{StaticResource PrimaryText}" 
                   FontSize="32" 
                   FontWeight="Bold" 
                   Margin="0,0,0,35"/>

        <TextBlock Text="Имя пользователя" 
                   Foreground="{StaticResource SecondaryText}" 
                   FontSize="12"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <TextBox Style="{StaticResource ModernTextBox}" x:Name="UsernameInput"/>

        <TextBlock Text="Пароль" 
                   Foreground="{StaticResource SecondaryText}" 
                   FontSize="12"
                   FontWeight="SemiBold"
                   Margin="0,20,0,8"/>

        <PasswordBox Style="{StaticResource ModernPasswordBox}" x:Name="PasswordInput"/>

        <Button x:Name="LoginButton"
        Style="{StaticResource ModernButton}" 
        Margin="0,20,0,0" 
        Click="Login_Click">
            <Grid>
                <TextBlock x:Name="ButtonText" Text="ВОЙТИ" VerticalAlignment="Center"/>

                <Path x:Name="LoadingIcon"
      Data="M 10,0 A 10,10 0 1 1 0,10" 
      Stroke="White" 
      StrokeThickness="3"
      Width="20" Height="20"
      Stretch="Uniform"
      Visibility="Collapsed"
      RenderTransformOrigin="0.5,0.5"
      StrokeStartLineCap="Round" 
      StrokeEndLineCap="Round">
                    <Path.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Path.RenderTransform>
                </Path>
            </Grid>
        </Button>

        <Button Content="Нет аккаунта? Зарегистрироваться" 
                Margin="0,20"
                Cursor="Hand"
                Click="GoToRegister_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" 
                            Value="Transparent"/>
                    <Setter Property="BorderThickness" 
                            Value="0"/>
                    <Setter Property="Foreground" 
                            Value="{StaticResource SecondaryText}"/>
                    <Setter Property="FontSize" 
                            Value="13"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" 
                                 Value="True">
                            <Setter Property="Foreground" 
                                    Value="{StaticResource PrimaryText}"/>
                            <Setter Property="TextBlock.TextDecorations" 
                                    Value="Underline"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</Page>
