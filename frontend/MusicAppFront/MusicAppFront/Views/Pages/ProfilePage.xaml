<Page x:Class="MusicAppFront.Views.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicAppFront.Views.Pages"
      mc:Ignorable="d" 
      Title="ProfilePage">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="50,30" VerticalAlignment="Top">

            <Grid Margin="0,0,0,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Ellipse Width="180" 
                         Height="180" 
                         Fill="{StaticResource AccentGradient}" 
                         Opacity="0.15">
                        <Ellipse.Effect>
                            <BlurEffect Radius="50"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Border Width="150" 
                        Height="150" 
                        CornerRadius="75" 
                        BorderThickness="2" 
                        Padding="2" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                        <Border.BorderBrush>
                            <StaticResource ResourceKey="AccentGradient"/>
                        </Border.BorderBrush>
                        <Border CornerRadius="75" 
                            Background="#18181B" 
                            ClipToBounds="True">
                            <TextBlock Text="&#xE77B;" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   Foreground="{StaticResource SecondaryText}" 
                                   FontSize="65" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" 
                                   Opacity="0.8"/>
                        </Border>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" 
                        VerticalAlignment="Center" 
                        Margin="45,0,0,0">
                    <TextBlock Text="Имя Пользователя" 
                           Foreground="{StaticResource PrimaryText}" 
                           FontSize="52" 
                           FontWeight="Black"/>
                    <StackPanel Orientation="Horizontal" 
                            Margin="2,12,0,0">
                        <Border Background="{StaticResource AccentGradient}" 
                            CornerRadius="6" 
                            Padding="12,4">
                            <TextBlock Text="STANDARD" 
                                   Foreground="{StaticResource PrimaryText}"
                                   FontSize="12"
                                   FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Подписка PREMIUM доступна при подключении ГосУслуг" 
                               Foreground="{StaticResource SecondaryText}" 
                               FontSize="16" 
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Background="#121217" 
                CornerRadius="20" 
                Padding="40,35" 
                Width="600" 
                HorizontalAlignment="Left" 
                Margin="0,0,0,40"
                BorderBrush="#1A1A1E"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ" 
                           Foreground="{StaticResource SecondaryText}" 
                           FontSize="13" 
                           FontWeight="Bold" 
                           Margin="0,0,0,35" 
                           Opacity="0.6"/>

                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   Foreground="{StaticResource SecondaryText}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,25,0" 
                                   FontSize="22"/>
                            <TextBlock Text="Имя" 
                                   Foreground="{StaticResource SecondaryText}" 
                                   FontSize="18" 
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="MAX_User" 
                               Foreground="{StaticResource PrimaryText}" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Center"/>
                    </Grid>
                    <Separator Background="#1A1A1E" Margin="0,22"/>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE715;" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   Foreground="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center" 
                                   Margin="0,0,25,0" 
                                   FontSize="22"/>
                            <TextBlock Text="Электронная почта" 
                                   Foreground="{StaticResource SecondaryText}" 
                                   FontSize="18" 
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="user@example.com" 
                               Foreground="{StaticResource PrimaryText}"
                               FontSize="18"
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="#1A1A1E" Margin="0,22"/>

                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   Foreground="{StaticResource SecondaryText}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,25,0" 
                                   FontSize="22"/>
                            <TextBlock Text="ID аккаунта" 
                                   Foreground="{StaticResource SecondaryText}" 
                                   FontSize="18" 
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="882341" 
                               Foreground="{StaticResource PrimaryText}" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,50">
                <Button Content="Подключить ГосУслуги" 
                    Style="{StaticResource AccentActionBtn}" 
                    Width="260" 
                    Height="50" 
                    FontSize="14"/>
                <Button Content="Выйти из аккаунта" 
                    Style="{StaticResource DangerActionBtn}" 
                    Width="200" Height="50"
                    Margin="20,0,0,0"
                    Click="Logout_Click" FontSize="14"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
