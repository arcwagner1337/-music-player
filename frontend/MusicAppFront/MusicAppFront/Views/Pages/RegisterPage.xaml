<Page x:Class="MusicAppFront.Views.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicAppFront.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="400"
      Title="RegisterPage"
      Background="Transparent">

    <StackPanel VerticalAlignment="Center" Margin="40,0">
        <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center" 
            Margin="0,0,0,30">
            <Border Width="40" 
            Height="50" 
            CornerRadius="12" 
            ClipToBounds="True">
                <Image Source="/Resources/logo.png" 
               Stretch="UniformToFill"/>
            </Border>
            <StackPanel VerticalAlignment="Center" 
                Margin="7,0,0,0">
                <TextBlock Text="MAX"
                           Foreground="White" 
                           FontSize="20" 
                           FontWeight="Black"/>
                <TextBlock Text="MUSIC"
                           Foreground="{StaticResource AccentGradient}" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Margin="0,-4,0,0"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Text="Регистрация" 
                   Foreground="{StaticResource PrimaryText}" 
                   FontSize="32" 
                   FontWeight="Bold" 
                   Margin="0,0,0,30"/>

        <TextBlock Text="Имя пользователя" 
                   Foreground="{StaticResource SecondaryText}" 
                   FontSize="12" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,8"/>
        <TextBox Style="{StaticResource ModernTextBox}" />

        <TextBlock Text="Электронная почта" 
                   Foreground="{StaticResource SecondaryText}" 
                   FontSize="12" FontWeight="SemiBold" Margin="0,20,0,8"/>
        <TextBox Style="{StaticResource ModernTextBox}" />

        <TextBlock Text="Пароль" 
                   Foreground="{StaticResource SecondaryText}" 
                   FontSize="12" 
                   FontWeight="SemiBold" 
                   Margin="0,20,0,8"/>
        <PasswordBox Style="{StaticResource ModernPasswordBox}"/>

        <Button Content="СОЗДАТЬ АККАУНТ" 
                Style="{StaticResource ModernButton}" 
                Margin="0,40,0,0"
                Click="CreateAccount_Click"/>

        <Button Content="Уже есть аккаунт? Войти" 
                Margin="0,20"
                Cursor="Hand"
                Click="GoBack_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" 
                            Value="Transparent"/>
                    <Setter Property="BorderThickness" 
                            Value="0"/>
                    <Setter Property="Foreground" 
                            Value="{StaticResource SecondaryText}"/>
                    <Setter Property="FontSize" 
                            Value="13"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" 
                                 Value="True">
                            <Setter Property="Foreground" 
                                    Value="{StaticResource PrimaryText}"/>
                            <Setter Property="TextBlock.TextDecorations" 
                                    Value="Underline"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</Page>
