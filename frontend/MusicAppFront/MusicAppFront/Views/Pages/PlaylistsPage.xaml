<Page x:Class="MusicAppFront.Views.Pages.PlaylistsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicAppFront.Views.Pages"
      mc:Ignorable="d" 
      Title="PlaylistsPage">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="30,20">
                <TextBlock Text="Мои плейлисты" 
                           Foreground="{StaticResource PrimaryText}"
                           FontSize="32" 
                           FontWeight="Black" 
                           Margin="10,0,0,30"/>

                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PlaylistCardStyle}"/>
                    <Button Style="{StaticResource PlaylistCardStyle}"/>
                    <Button Style="{StaticResource PlaylistCardStyle}"/>

                    <Button Style="{StaticResource CreateCardStyle}">
                        <StackPanel>
                            <Border Width="160" 
                                    Height="160" 
                                    CornerRadius="15" 
                                    Background="{StaticResource AccentGradient}"
                                    Margin="0,0,0,12">
                                <TextBlock Text="+" 
                                           Foreground="Black" 
                                           FontSize="60" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           Opacity="0.4"/>
                            </Border>
                            <TextBlock Text="Создать плейлист" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       FontSize="16" 
                                       Margin="5,0,0,0"/>
                            <TextBlock Text="Новая подборка" 
                                       Foreground="{StaticResource AccentGradient}" 
                                       FontSize="12"
                                       Margin="5,4,0,0"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
