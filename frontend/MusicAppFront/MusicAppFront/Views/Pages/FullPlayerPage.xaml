<Page x:Class="MusicAppFront.Views.Pages.FullPlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicAppFront.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="FullPlayerPage" Background="Transparent">

    <Grid>
        <Canvas IsHitTestVisible="False" Opacity="0.4">
            <Ellipse Width="500" 
                  Height="500" 
                  Fill="#157C3AED" 
                  Margin="-100,-100,0,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Button Content="&#xE70D;" 
             Style="{StaticResource FullPlayerCloseBtnStyle}" 
             Click="CloseFullPlayer_Click"/>

        <Grid Margin="50,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Viewbox VerticalAlignment="Center" MaxHeight="600">
                <Border CornerRadius="20" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" 
                                       Opacity="0.6" 
                                       ShadowDepth="0" 
                                       Color="Black"/>
                    </Border.Effect>
                    <Image Source="/Resources/logo.png" x:Name="BIG_TrackImage"
                        Width="400" 
                        Height="500" 
                        Stretch="UniformToFill"/>
                </Border>
            </Viewbox>

            <Grid Grid.Column="1" 
               Margin="40,20,0,20" 
               VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" 
                   VerticalAlignment="Center" 
                   Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Название трека" x:Name="BIG_TrackTitle"
                                Foreground="{StaticResource PrimaryText}"
                                FontSize="44" 
                                FontWeight="Black" 
                                TextWrapping="Wrap"
                                LineHeight="40" 
                                LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock Text="Исполнитель" x:Name="BIG_Author"
                                FontSize="22" 
                                FontWeight="SemiBold" 
                                Margin="0,5,0,0">
                            <TextBlock.Foreground>
                                <StaticResource ResourceKey="AccentGradient"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>

                    <CheckBox Grid.Column="1" 
                           Style="{StaticResource HeartToggleStyle}" 
                           Width="32" 
                           Height="32" 
                           VerticalAlignment="Center" 
                           Margin="20,0,10,0"/>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="0:00" x:Name="BIG_CurrentTime"
                                Foreground="{StaticResource SecondaryText}" 
                                FontSize="12" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Left"/>

                        <Slider Style="{StaticResource ModernSlider}" x:Name="BIG_Slider"
                                Grid.Column="1"
                                VerticalAlignment="Center" 
                                Margin="10,0"
                                Maximum="100" 
                                Value="0"
                                Thumb.DragStarted="BIG_TimelineSlider_DragStarted" 
                                Thumb.DragCompleted="BIG_TimelineSlider_DragCompleted"
                                PreviewMouseLeftButtonDown="BIG_TimelineSlider_PreviewMouseLeftButtonDown"
                                ValueChanged="BIG_TimelineSlider_ValueChanged"/>
                        <TextBlock Text="0:00" x:Name="BIG_TotalTime"
                                Grid.Column="2" 
                                Foreground="{StaticResource SecondaryText}" 
                                FontSize="12" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid>
                        <StackPanel Orientation="Horizontal" 
                                 HorizontalAlignment="Left">
                            <Button Content="&#xE8B1;" 
                                 FontFamily="Segoe MDL2 Assets" 
                                 Style="{StaticResource PlayerControlBtn}" 
                                 FontSize="14" 
                                 Margin="0,0,20,0"/>
                            <Button Content="&#xE892;" x:Name="BIG_PrevBtn"
                                 FontFamily="Segoe MDL2 Assets" 
                                 Style="{StaticResource PlayerControlBtn}" 
                                 FontSize="22"
                                    Click="BIG_PrevBtn_Click"/>
                            <Button Content="&#xE102;" x:Name="BIG_GlobalPlayPauseBtn"
                                 FontFamily="Segoe MDL2 Assets" 
                                 Style="{StaticResource PlayBtnStyle}" 
                                 Width="56" 
                                 Height="56" 
                                 FontSize="22" 
                                 Margin="20,0"
                                 Click="BIG_GlobalPlayPauseBtn_Click"/>
                            <Button Content="&#xE893;" x:Name="BIG_NextBtn"
                                 FontFamily="Segoe MDL2 Assets" 
                                 Style="{StaticResource PlayerControlBtn}" 
                                 FontSize="22"
                                    Click="BIG_NextBtn_Click"/>
                            <Button Content="&#xE8EE;" 
                                 FontFamily="Segoe MDL2 Assets" 
                                 Style="{StaticResource PlayerControlBtn}" 
                                 FontSize="14" 
                                 Margin="20,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" 
                                 HorizontalAlignment="Right" 
                                 VerticalAlignment="Center">
                            <TextBlock Text="&#xE767;" 
                                    FontFamily="Segoe MDL2 Assets" 
                                    Foreground="{StaticResource SecondaryText}" 
                                    VerticalAlignment="Center" 
                                    Margin="0,0,10,0" 
                                    FontSize="14"/>
                            <Slider Width="100" 
                                 Style="{StaticResource ModernSlider}" 
                                 Value="50" 
                                 VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
