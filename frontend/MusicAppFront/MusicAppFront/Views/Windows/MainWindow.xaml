<Window x:Class="MusicAppFront.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicAppFront"
        mc:Ignorable="d"
        Title="MAXMusic" Height="800" Width="1200"
        WindowStyle="None" AllowsTransparency="True"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="15" 
            Background="{StaticResource BgColor}" 
            BorderBrush="#27272A" 
            BorderThickness="1" 
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="95"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" 
                  Background="Transparent" 
                  MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="20,0">
                    <Border Width="30" 
                            Height="40" 
                            CornerRadius="8" 
                            ClipToBounds="True">
                        <Image Source="/Resources/logo.png" 
                               Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" 
                                Margin="5,0,0,0">
                        <TextBlock Text="MAX" 
                                   Foreground="White" 
                                   FontSize="18" 
                                   FontWeight="Black" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Music" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <StaticResource ResourceKey="AccentGradient"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1">
                    <StackPanel Orientation="Horizontal" 
                                VerticalAlignment="Center" 
                                Margin="20,0">
                        <RadioButton Content="Главная"
                                     Style="{StaticResource TopNavTab}" 
                                     IsChecked="True"
                                     Click="HomeTab_Click"/>
                        <RadioButton Content="MaxFlow" 
                                     Style="{StaticResource TopNavTab}" 
                                     Margin="25,0"
                                     Click="MaxFlowTab_Click"/>
                        <RadioButton Content="Профиль"
                                     Style="{StaticResource TopNavTab}" 
                                     Margin="0,0,50,0"
                                     Click="ProfileTab_Click"/>
                        <TextBox 
                            x:Name="SearchBox" 
                            Style="{StaticResource SearchTextBoxStyle}" 
                            Tag="Поиск треков..." 
                            VerticalAlignment="Center"
                            KeyDown="SearchBox_KeyDown"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Top" 
                            Margin="0,10,15,0">
                    <Button Content="—" 
                            Style="{StaticResource CloseButtonStyle}" 
                            Click="Minimize_Click" 
                            Margin="0,0,10,0"/>
                    <Button Content="✕" 
                            Style="{StaticResource CloseButtonStyle}" 
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" 
                        Background="#121217" 
                        CornerRadius="10" 
                        Margin="0,0,10,0">
                    <StackPanel Margin="10,15">
                        <TextBlock Text="МОЯ МЕДИАТЕКА"
                                   Foreground="{StaticResource SecondaryText}" 
                                   FontSize="13" 
                                   FontWeight="Bold" 
                                   Margin="15,0,0,15" 
                                   Opacity="0.9"/>

                        <Button Style="{StaticResource SideMenuBtn}"
                                Click="FavoritesTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE006;" 
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Избранное" 
                                           FontSize="14" 
                                           Margin="12,0,0,0" 
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SideMenuBtn}" 
                                Margin="0,5"
                                Click="PlaylistsTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" 
                                           FontFamily="Segoe MDL2 Assets" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Плейлисты" 
                                           FontSize="14" 
                                           Margin="12,0,0,0" 
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Separator Background="#27272A" 
                                   Margin="10,15" 
                                   Opacity="0.5"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" 
                        Background="#121217" 
                        CornerRadius="10" 
                        ClipToBounds="True">
                    <Grid>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse Width="350" 
                                     Height="350" 
                                     Fill="#127C3AED" 
                                     Margin="-100,-100,0,0">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="80"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="300" 
                                     Height="300" 
                                     Fill="#060EA5E9" 
                                     Canvas.Bottom="-80" 
                                     Canvas.Right="-80">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="80"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>

                        <Frame x:Name="MainFrame" 
                               NavigationUIVisibility="Hidden"
                               PreviewMouseLeftButtonDown="MainFrame_PreviewMouseLeftButtonDown"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" 
                    Background="{StaticResource BgColor}" 
                    BorderBrush="#27272A" 
                    BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center"
                                Cursor="Hand" 
                                Background="Transparent"
                                MouseLeftButtonDown="OpenFullPlayer_Click">
                        <Border Width="56" 
                                Height="56" 
                                Background="#282828" 
                                CornerRadius="6" 
                                ClipToBounds="True">
                            <!-- тут будет биндиться Image из API, backend -->
                            <TextBlock Text="🎵" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       FontSize="20" Opacity="0.5"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" 
                                    Margin="12,0,0,0">
                            <TextBlock Text="Название трека" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       FontSize="14"/>
                            <TextBlock Text="Исполнитель" 
                                       Foreground="{StaticResource SecondaryText}" 
                                       FontSize="12" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <CheckBox Style="{StaticResource HeartToggleStyle}" 
                                  Margin="20,0,0,0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <Button Content="&#xE8B1;" 
                                    FontFamily="Segoe MDL2 Assets" 
                                    Style="{StaticResource PlayerControlBtn}" 
                                    FontSize="14" 
                                    Margin="0,0,20,0"/>

                            <Button Content="&#xE892;" 
                                    FontFamily="Segoe MDL2 Assets" 
                                    Style="{StaticResource PlayerControlBtn}"/>

                            <Button Content="&#xE102;" 
                                    FontFamily="Segoe MDL2 Assets" 
                                    Style="{StaticResource PlayBtnStyle}" 
                                    Margin="20,0" Click="Button_Click"/>

                            <Button Content="&#xE893;" 
                                    FontFamily="Segoe MDL2 Assets" 
                                    Style="{StaticResource PlayerControlBtn}"/>

                            <Button Content="&#xE8EE;" 
                                    FontFamily="Segoe MDL2 Assets" 
                                    Style="{StaticResource PlayerControlBtn}" 
                                    FontSize="14" Margin="20,0,0,0"/>
                        </StackPanel>

                        <Grid Margin="0,10,0,0" Width="450">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0:00" 
                                       Foreground="{StaticResource SecondaryText}" 
                                       FontSize="11" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <Slider Style="{StaticResource ModernSlider}" 
                                    Grid.Column="1" 
                                    VerticalAlignment="Center" 
                                    Maximum="100" 
                                    Value="0"/>
                            <TextBlock Grid.Column="2" 
                                       Text="3:45" 
                                       Foreground="{StaticResource SecondaryText}" 
                                       FontSize="11" 
                                       VerticalAlignment="Center" 
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right">
                        <TextBlock Text="&#xE767;" 
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource SecondaryText}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,10,0" 
                                   FontSize="14"/>
                        <Slider Width="100" 
                                Style="{StaticResource ModernSlider}" 
                                Value="50" 
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
