<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MusicAppFront.Resources"
                    xmlns:win="clr-namespace:MusicAppFront.Views.Windows">

    <!-- ФОН ОКНА -->
    <SolidColorBrush x:Key="BgColor" Color="#09090B"/>
    <SolidColorBrush x:Key="SecondaryBg" Color="#121217"/>

    <!-- Заголовки (Белый) -->
    <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
    <!-- Подписи (Светло-серый) -->
    <SolidColorBrush x:Key="SecondaryText" Color="#A1A1AA"/>

    <!-- ЦВЕТА ПОЛЕЙ -->
    <SolidColorBrush x:Key="InputBg" Color="#18181B"/>
    <SolidColorBrush x:Key="InputBorder" Color="#27272A"/>

    <!-- ГРАДИЕНТ ДЛЯ КНОПОК -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#0EA5E9" Offset="1"/>
    </LinearGradientBrush>

    <!-- ШАБЛОН ДЛЯ ПОЛЕЙ (TextBox и PasswordBox) -->
    <Style x:Key="BaseFieldStyle" TargetType="Control">
        <Setter Property="Background" Value="{StaticResource InputBg}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    
    

    <!-- СТИЛЬ ДЛЯ CLOSEBUTTON -->
    <Style x:Key="CloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#71717A"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Margin" Value="0,0,15,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- СТИЛЬ ДЛЯ TEXTBOX -->
    <Style x:Key="ModernTextBox" TargetType="TextBox" BasedOn="{StaticResource BaseFieldStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" CornerRadius="8" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="2,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#7C3AED"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#3F3F46"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- СТИЛЬ ДЛЯ PASSWORDBOX -->
    <Style x:Key="ModernPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource BaseFieldStyle}">
        <Setter Property="PasswordChar" Value="●"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="border" CornerRadius="8" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="2,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#3F3F46"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#7C3AED"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- СТИЛЬ ДЛЯ КНОПКИ -->
    <Style x:Key="ModernButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="24" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- СТИЛЬ ДЛЯ ВЕРХНЕЙ ПАНЕЛИ -->
    <Style x:Key="TopNavTab" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,3" Padding="0,8">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentGradient}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- стиль кнопки SideBar  -->
    <Style x:Key="SideMenuBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="15,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="border" Property="Background" Value="#27272A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Круглая кнопка Play -->
    <Style x:Key="PlayBtnStyle" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="19" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопки управления (Next/Prev/Shuffle) с аккуратным наведением -->
    <Style x:Key="PlayerControlBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- стиль для слайдера -->
    <Style x:Key="ModernSlider" TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="4" Background="#3E3E42" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Height="4" Background="{StaticResource AccentGradient}" CornerRadius="2"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Ellipse Fill="White" StrokeThickness="0"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль сердечка (Избранное) -->
    <Style x:Key="HeartToggleStyle" TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <TextBlock x:Name="icon" 
                               Text="&#xE006;" 
                               FontFamily="Segoe MDL2 Assets" 
                               FontSize="16" 
                               Foreground="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="icon" Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="icon" Property="Text" Value="&#xE00B;"/>
                            <Setter TargetName="icon" Property="Foreground" Value="#7C3AED"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- стиль для строки поиска -->
    <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#1A1A1E"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#27272A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="38,0,15,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Width" Value="550"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="14">
                            <Grid>
                                <TextBlock Text="&#xE721;" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       Foreground="{StaticResource SecondaryText}" 
                                       FontSize="11" 
                                       Margin="14,0,0,0" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Left"
                                       RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="-1"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="12"
                                       Margin="38,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Opacity="0.5"
                                       Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#7C3AED"/>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" Color="#7C3AED" Opacity="0.2" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Стиль кнопки "Свернуть" для плеера -->
    <Style x:Key="FullPlayerCloseBtnStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,25,25,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- Дизайн карточки трека -->
    <Style x:Key="TrackCardStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="#18181B"/>
        <Setter Property="Width" Value="190"/>
        <Setter Property="Height" Value="270"/>
        <Setter Property="Margin" Value="0,0,15,20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="cardBorder"
                            Background="{TemplateBinding Background}" 
                            CornerRadius="20" 
                            Padding="12"
                            BorderBrush="#252529" 
                            BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Border x:Name="imgBorder" CornerRadius="10" ClipToBounds="True" Height="170" Background="Transparent">
                                    
                                    <Image Source="{Binding ImageUrl}" 
                                        Stretch="UniformToFill" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="playButton" 
                                        Width="48" Height="48"
                                        Background="{StaticResource AccentGradient}"
                                        CornerRadius="24" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Bottom" 
                                        Margin="0,0,10,-10" 
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="10"/>
                                    </Border.RenderTransform>
                                    <TextBlock Text="&#xE102;" 
                                               FontFamily="Segoe MDL2 Assets" 
                                               Foreground="White" FontSize="18" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>   
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Opacity="0.4" ShadowDepth="5"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>

                            <!-- тут будут биндинги из api -->
                            <TextBlock Text="{Binding Title}" 
                                Foreground="White" FontWeight="Bold" 
                                FontSize="15" Margin="0,15,0,5"
                                TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="{Binding Artist}" 
                                Foreground="{StaticResource AccentGradient}" 
                                FontSize="13" Margin="0,0,0,5"/>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="cardBorder" Property="Background" Value="#27272A"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="playButton" 
                                                 Storyboard.TargetProperty="Opacity" 
                                                 To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="playButton" 
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                 To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CircleEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="playButton" 
                                                 Storyboard.TargetProperty="Opacity" 
                                                 To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="playButton" 
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                 To="20" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- КНОПКА Госуслуги  -->
    <Style x:Key="AccentActionBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- КНОПКА ВЫХОДА -->
    <Style x:Key="DangerActionBtn" TargetType="Button">
        <Setter Property="Background" Value="#1A1A1E"/>
        <Setter Property="Foreground" Value="#F87171"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                         Background="{TemplateBinding Background}" 
                         BorderBrush="#3F3F46" 
                         BorderThickness="1" 
                         CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#EF4444"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- КАРТОЧКИ ПЛЕЙЛИСТОВ -->
    <Style x:Key="PlaylistCardStyle" TargetType="Button">
        <Setter Property="Background" Value="#18181D"/>
        <Setter Property="Width" Value="190"/>
        <Setter Property="Height" Value="270"/>
        <Setter Property="Margin" Value="0,0,15,20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="cardBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="20" 
                                Padding="12"
                                BorderBrush="#252529" 
                                BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Border Width="160" Height="160" CornerRadius="15" ClipToBounds="True">
                                    <Image Source="{Binding ImageUrl}" 
               Stretch="UniformToFill" 
               RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <Border x:Name="playButton" 
                                            Width="44" Height="44" 
                                            Background="{StaticResource AccentGradient}" 
                                            CornerRadius="22" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Bottom" 
                                            Margin="0,0,10,10" 
                                            Opacity="0" 
                                            RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="15"/>
                                    </Border.RenderTransform>
                                    <TextBlock Text="&#xE768;" 
                                                   FontFamily="Segoe MDL2 Assets" 
                                                   Foreground="White" 
                                                   FontSize="18" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" 
                                                   Margin="3,0,0,0"/>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Opacity="0.4" ShadowDepth="5"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <!-- Заголовки (потом заменим на Binding) -->
                            <TextBlock Text="{Binding Name}"
                                           Foreground="White" 
                                           FontWeight="Bold" 
                                           FontSize="15" 
                                           Margin="5,12,0,2" 
                                           TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="" 
                                           Foreground="{StaticResource AccentGradient}" 
                                           FontSize="12" 
                                           Margin="5,0,0,5"/>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="cardBorder" Property="Background" Value="#222228"/>
                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="#3F3F46"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="playButton" 
                                                         Storyboard.TargetProperty="Opacity" 
                                                         To="1" 
                                                         Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="playButton" 
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                         To="0"
                                                         Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CircleEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="playButton" 
                                                         Storyboard.TargetProperty="Opacity" 
                                                         To="0" 
                                                         Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="playButton" 
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                         To="15" 
                                                         Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- КАРТОЧКА СОЗДАНИЯ ПЛЕЙЛИСТОВ -->
    <Style x:Key="CreateCardStyle" TargetType="Button">
        <Setter Property="Background" Value="#18181D"/>
        <Setter Property="Width" Value="190"/>
        <Setter Property="Height" Value="270"/>
        <Setter Property="Margin" Value="0,0,15,20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20" 
                            Padding="12" BorderBrush="#252529" BorderThickness="1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#222228"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#3F3F46"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль-контейнер для списка треков -->
    <Style x:Key="TrackListContainer" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="#0D0D11" 
                            CornerRadius="20" 
                            Padding="10" 
                            BorderBrush="#1A1A1E" 
                            BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="20,10,20,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="#" 
                                           Foreground="{StaticResource SecondaryText}" 
                                           Opacity="0.5" 
                                           FontWeight="Bold" 
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1" 
                                           Text="НАЗВАНИЕ" 
                                           Foreground="{StaticResource SecondaryText}" 
                                           Opacity="0.5" 
                                           FontSize="11" 
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" 
                                           Text="АЛЬБОМ" 
                                           Foreground="{StaticResource SecondaryText}" 
                                           Opacity="0.5" 
                                           FontSize="11" 
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" 
                                           Text="&#xE916;" 
                                           FontFamily="Segoe MDL2 Assets" 
                                           Foreground="{StaticResource SecondaryText}"
                                           Opacity="0.5" 
                                           HorizontalAlignment="Right" 
                                           Margin="0,0,70,0" 
                                           FontSize="14"/>
                            </Grid>
                            <Separator Background="#1A1A1E" Margin="10,0,10,10" Opacity="0.5"/>
                            <ContentPresenter/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль треков в списке (избранное/maxflow) -->
    <Style x:Key="TrackRowStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>

        

        <Setter Property="Height" Value="64"/>
        <Setter Property="Margin" Value="5,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>



                <ControlTemplate TargetType="Button">

                    <ControlTemplate.Resources>
                        <Storyboard x:Key="RotationAnim">
                            <!-- Имя цели loadingIcon совпадает, анимация отработает штатно -->
                            <DoubleAnimation Storyboard.TargetName="loadingIcon"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1"
                             RepeatBehavior="Forever"/>
                        </Storyboard>
                    </ControlTemplate.Resources>




                    <Border x:Name="trackBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="15,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="trackNum" 
               Text="▶" 
               Foreground="{StaticResource SecondaryText}" 
               VerticalAlignment="Center" HorizontalAlignment="Center"
               FontSize="12"/>

                            <Path x:Name="loadingIcon" 
                  Data="M 0,10 A 10,10 0 1 1 0.01,10" 
                  Stroke="{StaticResource AccentGradient}" 
                  StrokeThickness="2" 
                  StrokeDashArray="3 1"
                  Width="14" Height="14"
                  Stretch="Uniform"
                  VerticalAlignment="Center" 
                  HorizontalAlignment="Center"
                  Visibility="Collapsed"
                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>


                            <Path x:Name="loadingIcon2"
                                Data="M 10,0 A 10,10 0 1 1 0,10" 
                                Stroke="White" 
                                StrokeThickness="3"
                                Width="20" Height="20"
                                Stretch="Uniform"
                                Visibility="Collapsed"
                                RenderTransformOrigin="0.5,0.5"
                                StrokeStartLineCap="Round" 
                                StrokeEndLineCap="Round">
                            </Path>


                            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">
                                <Border Width="44" 
                        Height="44" 
                        Background="#1A1A1E" 
                        CornerRadius="6" 
                        Margin="0,0,15,0"
                        ClipToBounds="True">
                                    <Image Source="{Binding ImageUrl}" 
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               FontSize="15"
                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding Author}" 
                               Foreground="{StaticResource SecondaryText}" 
                               FontSize="13" 
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="2" 
                       Text="{Binding CleanTitle}" 
                       Foreground="{StaticResource SecondaryText}" 
                       VerticalAlignment="Center" 
                       FontSize="14" 
                       Opacity="0.8"
                       TextTrimming="CharacterEllipsis"
                       Margin="10,0"/>

                            <StackPanel Grid.Column="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center">




                                <Grid Margin="0,0,5,0">
                                    <ToggleButton x:Name="AddPlaylistToggle" 
                                                  local:ClickHelper.Handled="True"
                  Background="Transparent" 
                  BorderThickness="0" 
                  Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="btnBorder" 
                        Background="Transparent" 
                        Width="32" 
                        Height="32" 
                        CornerRadius="16">
                                                    <TextBlock x:Name="icon" 
                               IsHitTestVisible="False"  Text="&#xE710;"
                               FontFamily="Segoe MDL2 Assets" 
                               Foreground="{StaticResource SecondaryText}" 
                               FontSize="13" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Opacity="0.6"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#2A2A2E"/>
                                                        <Setter TargetName="icon" Property="Foreground" Value="White"/>
                                                        <Setter TargetName="icon" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#7C3AED"/>
                                                        <Setter TargetName="icon" Property="Foreground" Value="White"/>
                                                        <Setter TargetName="icon" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <Popup x:Name="AddPlaylistPopup"
       IsOpen="{Binding IsChecked, ElementName=AddPlaylistToggle, Mode=TwoWay}" 
       PlacementTarget="{Binding ElementName=AddPlaylistToggle}" 
       Placement="Bottom" 
       StaysOpen="False" 
       AllowsTransparency="True" 
       PopupAnimation="Fade">
                                        <Border Background="#0D0D11" 
            BorderBrush="#27272A" 
            BorderThickness="1" 
            CornerRadius="12" 
            Padding="5" 
            Width="220" 
            Margin="0,5,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="25" Color="Black" Opacity="0.6" ShadowDepth="3"/>
                                            </Border.Effect>

                                            <StackPanel local:ClickHelper.Handled="True">
                                                <TextBlock Text="ДОБАВИТЬ В ПЛЕЙЛИСТ" 
                       Foreground="{StaticResource SecondaryText}" 
                       FontSize="10" FontWeight="Bold" 
                       Margin="15,10,15,8" Opacity="0.5"/>

                                                <Separator Background="#1A1A1E" Margin="5,0,5,5"/>

                                                <ItemsControl ItemsSource="{Binding Source={x:Static win:MainWindow.Instance}, Path=UserPlaylists}"
              x:Name="PlaylistsList"
              Tag="{Binding}">

                                                    <ItemsControl.Resources>
                                                        <local:TupleConverter x:Key="MyTupleConverter"/>
                                                    </ItemsControl.Resources>

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource SideMenuBtn}"  
                    Content="{Binding}"  
                    Height="35" FontSize="13" Padding="15,0"
                    Command="{x:Static local:PlaylistCommands.AddTrackToPlaylist}">
                                                                <Button.CommandParameter>
                                                                    <MultiBinding Converter="{StaticResource MyTupleConverter}">

                                                                        <Binding />

                                                                        <Binding Path="Tag" ElementName="PlaylistsList"/>
                                                                    </MultiBinding>
                                                                </Button.CommandParameter>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Separator Background="#1A1A1E" Margin="5,5,5,5"/>

                                                <Button Style="{StaticResource SideMenuBtn}" 
                    Content="+ Создать плейлист" 
                    Height="35" FontSize="13" Padding="15,0"
                    Foreground="#A78BFA"
                    Command="{x:Static local:PlaylistCommands.RedirectToCreatePlaylist}"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>












                                <TextBlock Text="{Binding DurationStr}" 
                           Foreground="{StaticResource SecondaryText}" 
                           VerticalAlignment="Center" 
                           Margin="0,0,0,0" 
                           FontSize="14"/>

                                <CheckBox Style="{StaticResource HeartToggleStyle}" 
                          IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                          VerticalAlignment="Center" 
                          Margin="20,0,10,0"
                          />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="trackNum" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="loadingIcon" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource RotationAnim}" Name="LoadingAnimBegin"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="LoadingAnimBegin"/>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="trackBorder" Property="Background" Value="#2A2A2E"/>
                            <Setter TargetName="trackNum" Property="Foreground" Value="White"/>
                        </Trigger>

                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter TargetName="trackNum" Property="Text" Value="⏸"/>
                            <Setter TargetName="trackNum" Property="Foreground" Value="#1DB954"/>
                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPlaying}" Value="False"/>
                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="trackNum" Property="Text" Value="▶"/>
                        </MultiDataTrigger>


                    </ControlTemplate.Triggers>


                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Карточка артиста -->
    <Style x:Key="ArtistCardStyle" TargetType="Button">
        <Setter Property="Width" Value="170"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="cardBorder" Background="Transparent" CornerRadius="12" Padding="10">
                        <StackPanel>
                            <Ellipse x:Name="imageCircle"
         Width="130" 
         Height="130" 
         HorizontalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding ImageUrl}" 
                    Stretch="UniformToFill"
                    RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <TextBlock Text="{Binding Name}" 
               Foreground="White" 
               FontWeight="Bold" 
               FontSize="14" 
               HorizontalAlignment="Center" 
               Margin="0,15,0,4"
               TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="Исполнитель" 
               Foreground="{StaticResource AccentGradient}" 
               FontSize="12" 
               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="cardBorder" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
    